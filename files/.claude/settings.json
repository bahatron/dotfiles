{
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/files/.claude/mods/cold-cache-guard"
  },
  "permissions": {
    "allow": [
      "Bash(docker *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git worktree *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "fable",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume|startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/assistant/hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/assistant/hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/assistant/hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/assistant/hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/never-ask.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rtk-plugin@enix": true
  },
  "extraKnownMarketplaces": {
    "enix": {
      "source": {
        "source": "github",
        "repo": "enixCode/plugins"
      }
    }
  },
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus": {},
    "claude-fable": {},
    "claude-haiku-5-5": {
      "effortLevel": "low",
      "maxEffortLevel": "low"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false
}
