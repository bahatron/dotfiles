{
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/files/.claude/mods/cold-cache-guard"
  },
  "permissions": {
    "allow": [
      "Bash(docker *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git worktree *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/never-ask.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rtk-plugin@enix": true
  },
  "extraKnownMarketplaces": {
    "enix": {
      "source": {
        "source": "github",
        "repo": "enixCode/plugins"
      }
    }
  },
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5": {},
    "claude-fable-5-1[1m]": {},
    "claude-fable-5-1": {},
    "claude-opus-5-5": {}
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false
}
